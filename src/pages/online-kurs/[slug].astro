---
import Header from '../../components/Header.astro';
import LevelCourseDetail from '../../components/LevelCourseDetail.astro';
import Footer from '../../components/Footer.astro';
import Layout from '../../layouts/Layout.astro';
import { onlineLevelCourses } from '../../data/courseDetails';

export function getStaticPaths() {
	return onlineLevelCourses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props;
---

<Layout title={`${course.title} | Deutschzeit`}>
	<Header />
	<LevelCourseDetail course={course} />
	<Footer />
</Layout>
