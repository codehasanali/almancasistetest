---
interface Props {
	title?: string;
}

const { title = 'Deutschzeit' } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Online ve yüz yüze Almanca kursları, özel dersler ve sınav hazırlık programları." />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #fff;
		overflow-x: clip;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
</style>
