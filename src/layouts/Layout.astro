---
interface Props {
	title?: string;
}

const { title = 'Deutschzeit' } = Astro.props;
---

<!doctype html>
<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Online ve yüz yüze Almanca kursları, özel dersler ve sınav hazırlık programları." />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href="/logo.png" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<a
			class="whatsapp-button"
			href="https://wa.me/905378424809"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="WhatsApp üzerinden iletişime geç"
		>
			<svg viewBox="0 0 32 32" aria-hidden="true">
				<path d="M16 3a13 13 0 0 0-11.1 19.8L3.2 29l6.4-1.7A13 13 0 1 0 16 3Zm0 23.6c-2.1 0-4.1-.6-5.8-1.7l-.4-.2-3.8 1 1-3.7-.2-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.8.2l-1 1.2c-.2.2-.4.2-.7.1a8.7 8.7 0 0 1-2.6-1.6 9.7 9.7 0 0 1-1.8-2.3c-.2-.3 0-.5.1-.6l.5-.6.3-.5c.1-.2.1-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.8-.5h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.3 1.4 3.5c.2.2 2.5 3.8 6 5.3.8.4 1.5.6 2 .7.8.3 1.6.2 2.2.1.7-.1 1.9-.8 2.2-1.5.3-.7.3-1.4.2-1.5-.1-.3-.4-.4-.7-.5Z" />
			</svg>
		</a>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background: #fff;
		overflow-x: clip;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	.whatsapp-button {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 1000;
		display: flex;
		width: 60px;
		height: 60px;
		align-items: center;
		justify-content: center;
		padding: 12px;
		border: 3px solid #fff;
		border-radius: 50%;
		background: #25d366;
		box-shadow: 0 6px 20px rgba(0, 0, 0, .28);
		line-height: 0;
		text-decoration: none;
		transition: transform .2s ease, background-color .2s ease, box-shadow .2s ease;
	}

	.whatsapp-button:hover {
		background: #1ebe5d;
		transform: translateY(-3px);
		box-shadow: 0 9px 24px rgba(0, 0, 0, .32);
	}

	.whatsapp-button:focus-visible {
		outline: 3px solid #128c4a;
		outline-offset: 3px;
	}

	.whatsapp-button svg {
		display: block;
		width: 100%;
		height: 100%;
		flex: none;
		fill: #fff;
	}

	@media (max-width: 600px) {
		.whatsapp-button {
			right: 16px;
			bottom: max(16px, env(safe-area-inset-bottom));
			width: 56px;
			height: 56px;
			padding: 10px;
		}
	}
</style>
