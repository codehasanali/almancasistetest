	button { display: inline-flex; min-height: 47px; align-items: center; gap: 16px; padding: 0 19px; border: 0; background: var(--red); color: #fff; cursor: pointer; font-size: 9px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
	button span { color: var(--yellow); font-size: 18px; }

