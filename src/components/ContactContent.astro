	.label span { width: 29px; height: 3px; background: var(--yellow); }
	h1 { margin: 0; color: var(--ink); font-family: Georgia, serif; font-size: clamp(48px, 5.5vw, 70px); font-weight: 500; letter-spacing: -.05em; line-height: .98; }
	h1 em { color: var(--red); font-weight: 500; }
