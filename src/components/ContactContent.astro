	.contact-item a, .contact-item strong { color: #fff; font-family: Georgia, serif; font-size: 18px; font-weight: 500; text-decoration: none; }
	.contact-item p { margin: 7px 0 0; color: #999; font-size: 10px; line-height: 1.5; }
	.instagram-link { display: inline-flex; margin-top: 24px; align-items: center; gap: 11px; color: #fff; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
