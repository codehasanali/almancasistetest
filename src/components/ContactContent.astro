		.contact-main { padding: 70px 0; }
		.field-row { grid-template-columns: 1fr; }
		.form-bottom { align-items: flex-start; flex-direction: column; }
		.quick-links > div > div { grid-template-columns: 1fr; }
		.quick-links a + a { border-top: 1px solid rgb(27 27 27 / 25%); border-left: 0; }
	}
