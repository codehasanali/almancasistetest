	input, select, textarea { width: 100%; border: 1px solid #d9d5ce; border-radius: 0; background: #fff; color: var(--ink); font: 13px Inter, Arial, sans-serif; outline: none; transition: border-color 160ms ease; }
	input, select { height: 48px; padding: 0 13px; }
