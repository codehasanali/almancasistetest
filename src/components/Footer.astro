---
const mainLinks = [
	{ label: 'Ana Sayfa', href: '/' },
	{ label: 'Hakkımızda', href: '/hakkimizda' },
	{ label: 'Online Almanca Kursu', href: '/online-kurs' },
	{ label: 'Almanca Özel Ders', href: '/ozel-ders' },
	{ label: 'Almanca Seviye Testi', href: '/seviye-testi' },
	{ label: 'Online Almanca Öğrenmek', href: '/online-almanca-ogrenmek' },
	{ label: 'Almanca Sertifika Sınavları', href: '/almanca-sertifika-sinavlari' },
	{ label: 'Sıkça Sorulan Sorular', href: '/sss' },
];

const programLinks = [
	{ label: 'Abitur & Matura Hazırlık', href: '/sinav-hazirligi/abitur-hazirlik' },
	{ label: 'TestDaF Hazırlık', href: '/sinav-hazirligi/testdaf-hazirlik' },
	{ label: 'DSD 1-2 Hazırlık', href: '/sinav-hazirligi/dsd-1-hazirlik' },
	{ label: 'İş Almancası', href: '/ders-alanlari/is-almancasi' },
	{ label: 'İletişim', href: '/iletisim' },
	{ label: 'Gizlilik Politikası', href: '/#gizlilik' },
];
---

<footer class="site-footer" id="iletisim">
	<div class="footer-accent" aria-hidden="true"><span></span><span></span></div>
	<div class="footer-container">
		<div class="footer-main">
			<div class="footer-brand">
				<a href="/" aria-label="Deutschzeit anasayfa">
					<img src="/logo.png" alt="Deutschzeit" width="150" height="100" />
				</a>
				<p>Almanca öğrenme hedeflerinize uzman eğitmenler, kişisel eğitim planları ve canlı online derslerle ulaşın.</p>
				<a class="instagram" href="#" aria-label="Deutschzeit Instagram hesabı">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm-.1 2A3.1 3.1 0 0 0 4 7.1v9.8A3.1 3.1 0 0 0 7.1 20h9.8a3.1 3.1 0 0 0 3.1-3.1V7.1A3.1 3.1 0 0 0 16.9 4H7.1Zm10.2 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" /></svg>
					Instagram
				</a>
			</div>

			<nav class="footer-nav" aria-label="Footer ana bağlantıları">
				<h2>Deutschzeit</h2>
				<ul>{mainLinks.map((link) => <li><a href={link.href}>{link.label}<span>→</span></a></li>)}</ul>
			</nav>

			<nav class="footer-nav" aria-label="Footer program bağlantıları">
				<h2>Programlar & Bilgi</h2>
				<ul>{programLinks.map((link) => <li><a href={link.href}>{link.label}<span>→</span></a></li>)}</ul>
			</nav>

			<div class="footer-contact">
				<h2>İletişim</h2>
				<p>Eğitim programları hakkında bilgi almak için danışmanlarımızla iletişime geçin.</p>
				<a class="phone" href="tel:+905000000000"><small>Telefon</small><strong>+90 500 000 00 00</strong></a>
				<a class="contact-button" href="/iletisim">Bize Yazın <span>→</span></a>
			</div>
		</div>

		<div class="footer-bottom">
			<p>© {new Date().getFullYear()} Deutschzeit. Tüm hakları saklıdır.</p>
			<p>Online Almanca Eğitim Merkezi</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		--red: #dc0b20;
		--yellow: #f2b900;
		--ink: #151515;
		position: relative;
		padding: 82px 0 0;
		background: #0f0f0f;
		color: #fff;
		font-family: Inter, Arial, Helvetica, sans-serif;
		overflow: hidden;
	}

	.footer-accent { position: absolute; top: 0; right: 0; left: 0; display: grid; height: 5px; grid-template-columns: 72% 28%; }
	.footer-accent span:first-child { background: var(--red); }
	.footer-accent span:last-child { background: var(--yellow); }
	.footer-container { width: min(1370px, calc(100% - 64px)); max-width: 100%; margin-inline: auto; }
	.footer-main { display: grid; grid-template-columns: 1.15fr .8fr 1fr .9fr; gap: clamp(35px, 5vw, 75px); padding-bottom: 68px; }

	.footer-brand > a:first-child { display: grid; width: 158px; height: 96px; place-items: center; overflow: hidden; background: #fff; }
	.footer-brand img { display: block; width: 142px; height: 95px; object-fit: contain; }
	.footer-brand > p { max-width: 310px; margin: 25px 0 22px; color: #9d9d9d; font-size: 12px; line-height: 1.75; }
	.instagram { display: inline-flex; align-items: center; gap: 9px; color: #fff; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.instagram svg { width: 18px; height: 18px; fill: var(--yellow); }

	.footer-main h2 { margin: 0 0 24px; color: #fff; font-size: 11px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
	.footer-main h2::after { display: block; width: 28px; height: 2px; margin-top: 12px; background: var(--red); content: ''; }
	.footer-nav ul { display: grid; margin: 0; padding: 0; gap: 14px; list-style: none; }
	.footer-nav a { display: flex; align-items: center; justify-content: space-between; gap: 10px; color: #a9a9a9; font-size: 11.5px; line-height: 1.4; text-decoration: none; transition: color 160ms ease; }
	.footer-nav a span { color: var(--red); opacity: 0; transform: translateX(-5px); transition: opacity 160ms ease, transform 160ms ease; }
	.footer-nav a:hover { color: #fff; }
	.footer-nav a:hover span { opacity: 1; transform: none; }

	.footer-contact > p { margin: 0 0 22px; color: #999; font-size: 11.5px; line-height: 1.7; }
	.phone { display: flex; margin-bottom: 24px; flex-direction: column; gap: 6px; color: #fff; text-decoration: none; }
	.phone small { color: #777; font-size: 9px; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
	.phone strong { font-family: Georgia, serif; font-size: 19px; font-weight: 500; }
	.contact-button { display: inline-flex; min-height: 42px; align-items: center; gap: 16px; padding: 0 17px; background: var(--red); color: #fff; font-size: 9px; font-weight: 800; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
	.contact-button span { color: var(--yellow); font-size: 17px; }

	.footer-bottom { display: flex; min-height: 70px; align-items: center; justify-content: space-between; gap: 25px; border-top: 1px solid #2d2d2d; color: #686868; font-size: 9px; letter-spacing: .06em; text-transform: uppercase; }
	.footer-bottom p { margin: 0; }

	@media (max-width: 1000px) {
		.footer-main { grid-template-columns: 1fr 1fr; row-gap: 55px; }
	}

	@media (max-width: 620px) {
		.site-footer { padding-top: 62px; }
		.footer-container { width: calc(100% - 36px); }
		.footer-main { grid-template-columns: 1fr; gap: 45px; padding-bottom: 50px; }
		.footer-brand > p { max-width: 430px; }
		.footer-nav a { max-width: 330px; }
		.footer-bottom { min-height: 90px; align-items: flex-start; justify-content: center; flex-direction: column; gap: 8px; }
	}
</style>
