---
const features = [
	{ number: '01', title: 'Size Özel Müfredat', text: 'Ders içeriği mevcut seviyenize, öğrenme hızınıza ve ulaşmak istediğiniz hedefe göre hazırlanır.' },
	{ number: '02', title: 'Esnek Ders Programı', text: 'Ders günlerini ve saatlerini eğitmeninizle birlikte planlayarak eğitimi günlük hayatınıza uyarlayın.' },
	{ number: '03', title: 'Birebir Eğitmen Desteği', text: 'Ders boyunca yalnızca sizin gelişiminize odaklanan eğitmeninizden anlık geri bildirim alın.' },
	{ number: '04', title: 'Konuşma Odaklı Eğitim', text: 'Almancayı gerçek yaşam senaryolarıyla aktif olarak kullanın ve konuşma özgüveninizi geliştirin.' },
];

const audiences = [
	'Almancaya sıfırdan başlamak isteyenler',
	'Konuşma pratiğini geliştirmek isteyenler',
	'Goethe, TELC, ÖSD veya TestDaF sınavına hazırlananlar',
	'Almanya’da eğitim veya kariyer hedefleyenler',
	'Yoğun çalışma temposuna uygun esnek program arayanlar',
	'Mevcut seviyesini kısa sürede ilerletmek isteyenler',
];

const packages = [
	{ name: 'Başlangıç Paketi', lessons: '8 Ders', price: '9.900 TL', unit: 'Ders başına 1.237,50 TL' },
	{ name: 'Gelişim Paketi', lessons: '16 Ders', price: '18.500 TL', unit: 'Ders başına 1.156,25 TL', featured: true },
	{ name: 'Yoğun Program', lessons: '24 Ders', price: '26.400 TL', unit: 'Ders başına 1.100 TL' },
];
---

<main class="private-page">
	<section class="private-hero">
		<div class="page-container hero-grid">
			<div class="hero-copy">
				<p class="eyebrow"><span></span> Birebir online eğitim</p>
				<h1>Hedefinize özel<br /><em>Almanca Özel Ders</em></h1>
				<p>Standart bir programa uyum sağlamak yerine, programı size uyarlayın. Deutschzeit birebir Almanca dersleriyle ihtiyaç duyduğunuz konulara odaklanın, kendi hızınızda ilerleyin ve Almancayı güvenle kullanmaya başlayın.</p>
				<div class="hero-actions">
					<a href="/iletisim">Ücretsiz Görüşme Planlayın <span>→</span></a>
					<p><strong>A1 - C1</strong><small>Tüm seviyelere uygun</small></p>
				</div>
			</div>
			<div class="hero-image">
				<img src="/private-german-lesson.jpg" alt="Online Almanca özel ders alan öğrenci" width="1400" height="933" fetchpriority="high" />
				<div class="image-note"><strong>1:1</strong><span>Tamamen size özel<br />canlı online ders</span></div>
			</div>
		</div>
	</section>

	<section class="features" aria-labelledby="features-title">
		<div class="page-container">
			<div class="section-heading">
				<p>Ders özellikleri</p>
				<h2 id="features-title">Öğrenme sürecinin merkezinde siz varsınız.</h2>
			</div>
			<div class="feature-grid">
				{features.map((feature) => (
					<article><span>{feature.number}</span><h3>{feature.title}</h3><p>{feature.text}</p></article>
				))}
			</div>
		</div>
	</section>

	<section class="pricing" aria-labelledby="pricing-title">
		<div class="page-container">
			<div class="section-heading pricing-heading">
				<p>Online birebir ders paketleri</p>
				<h2 id="pricing-title">Hedefinize ve çalışma temponuza uygun paketi seçin.</h2>
				<p class="pricing-intro">Her ders 60 dakika sürer. Ders içeriği seviyenize ve kişisel hedefinize göre eğitmeniniz tarafından hazırlanır.</p>
			</div>

			<div class="pricing-grid">
				{packages.map((item) => (
					<article class:list={['package-card', { featured: item.featured }] }>
						<div class="package-top">
							<span>{item.lessons}</span>
							{item.featured && <small>Önerilen Paket</small>}
						</div>
						<h3>{item.name}</h3>
						<div class="package-price"><strong>{item.price}</strong><span>{item.unit}</span></div>
						<ul>
							<li><span>✓</span> 60 dakika canlı online birebir ders</li>
							<li><span>✓</span> Kişisel ders ve gelişim planı</li>
							<li><span>✓</span> Dijital ders materyalleri</li>
							<li><span>✓</span> Esnek gün ve saat planlaması</li>
						</ul>
						<a href="/iletisim">Paketi Seçin <span>→</span></a>
					</article>
				))}
			</div>
			<p class="pricing-note">Paketler tek öğrenci için geçerlidir. Ders takvimi eğitmen uygunluğuna göre kayıt sırasında planlanır.</p>
		</div>
	</section>

	<section class="detail-section">
		<div class="page-container detail-grid">
			<div class="detail-copy">
				<p>Kimler için uygun?</p>
				<h2>Kendi hedefi ve temposuyla ilerlemek isteyen herkes için.</h2>
				<p class="detail-intro">Birebir dersler; genel Almanca, akademik Almanca, iş Almancası ve sınav hazırlığı gibi farklı hedeflere göre şekillendirilebilir.</p>
			</div>
			<ul>
				{audiences.map((audience) => <li><span>✓</span>{audience}</li>)}
			</ul>
		</div>
	</section>

	<section class="process" aria-labelledby="process-title">
		<div class="page-container">
			<div class="process-heading"><p>Nasıl ilerliyoruz?</p><h2 id="process-title">Üç adımda kişisel eğitim planınız</h2></div>
			<div class="process-list">
				<article><strong>01</strong><div><h3>Hedefinizi Tanıyoruz</h3><p>Seviyenizi, Almanca öğrenme amacınızı ve zaman planınızı birlikte değerlendiriyoruz.</p></div></article>
				<article><strong>02</strong><div><h3>Programınızı Oluşturuyoruz</h3><p>İçerik, ders sıklığı ve çalışma materyalleri ihtiyaçlarınıza göre planlanıyor.</p></div></article>
				<article><strong>03</strong><div><h3>Gelişiminizi Takip Ediyoruz</h3><p>Düzenli geri bildirimlerle ilerlemeniz ölçülüyor ve programınız gerektiğinde güncelleniyor.</p></div></article>
			</div>
		</div>
	</section>

	<section class="private-cta">
		<div class="page-container cta-inner">
			<div><p>İlk adımı atın</p><h2>Size uygun özel ders programını birlikte hazırlayalım.</h2></div>
			<a href="/iletisim">Bilgi Alın <span>→</span></a>
		</div>
	</section>
</main>

<style>
	.private-page { --red: #dc0b20; --red-dark: #a90516; --yellow: #f2b900; --ink: #1b1b1b; font-family: Inter, Arial, Helvetica, sans-serif; overflow: hidden; }
	.page-container { width: min(1160px, calc(100% - 64px)); max-width: 100%; margin-inline: auto; }
	.private-hero { padding: 76px 0 88px; background: #f7f6f3; }
	.hero-grid { display: grid; grid-template-columns: 1fr .92fr; align-items: start; gap: clamp(55px, 8vw, 105px); }
	.hero-copy { padding-top: 35px; }
	.eyebrow, .section-heading > p:first-child, .detail-copy > p:first-child, .process-heading > p, .cta-inner p { display: flex; margin: 0 0 18px; align-items: center; gap: 11px; color: var(--red); font-size: 10px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.eyebrow span { width: 29px; height: 3px; background: var(--yellow); }
	.hero-copy h1 { margin: 0; color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(48px, 5.4vw, 70px); font-weight: 500; letter-spacing: -.05em; line-height: .98; }
	.hero-copy h1 em { color: var(--red); font-weight: 500; }
	.hero-copy > p:not(.eyebrow) { max-width: 610px; margin: 28px 0 0; color: #68625b; font-size: 15px; line-height: 1.8; }
	.hero-actions { display: flex; margin-top: 34px; align-items: center; gap: 27px; }
	.hero-actions > a, .private-cta a { display: inline-flex; min-height: 49px; align-items: center; gap: 17px; padding: 0 20px; background: var(--red); color: #fff; font-size: 10px; font-weight: 800; letter-spacing: .055em; text-decoration: none; text-transform: uppercase; }
	.hero-actions > a span, .private-cta a span { color: var(--yellow); font-size: 18px; }
	.hero-actions > p { display: flex; margin: 0; flex-direction: column; gap: 3px; }
	.hero-actions strong { color: var(--ink); font-family: Georgia, serif; font-size: 18px; }
	.hero-actions small { color: #847e77; font-size: 9px; }
	.hero-image { position: relative; padding: 18px 22px 37px 0; }
	.hero-image::before { position: absolute; top: 0; right: 0; width: 80%; height: calc(100% - 37px); background: var(--red); content: ''; }
	.hero-image img { position: relative; z-index: 1; display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
	.image-note { position: absolute; z-index: 2; right: 0; bottom: 0; display: flex; min-width: 205px; align-items: center; gap: 14px; padding: 14px 18px; background: var(--ink); color: #fff; }
	.image-note strong { color: var(--yellow); font-family: Georgia, serif; font-size: 28px; }
	.image-note span { padding-left: 13px; border-left: 1px solid #4c4c4c; color: #ccc; font-size: 9px; line-height: 1.5; text-transform: uppercase; }

	.features { padding: 100px 0; background: #fff; }
	.section-heading { max-width: 690px; margin-bottom: 52px; }
	.section-heading h2, .detail-copy h2, .process-heading h2, .cta-inner h2 { margin: 0; color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(35px, 4vw, 50px); font-weight: 500; letter-spacing: -.035em; line-height: 1.1; }
	.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #ddd9d2; border-bottom: 1px solid #ddd9d2; }
	.feature-grid article { padding: 32px 27px 36px; }
	.feature-grid article + article { border-left: 1px solid #ddd9d2; }
	.feature-grid span { color: var(--red); font-family: Georgia, serif; font-size: 16px; }
	.feature-grid h3 { min-height: 51px; margin: 23px 0 13px; color: var(--ink); font-family: Georgia, serif; font-size: 21px; font-weight: 500; }
	.feature-grid p { margin: 0; color: #746e67; font-size: 12px; line-height: 1.75; }

	.pricing { padding: 100px 0 105px; background: #f5f3ef; }
	.pricing-heading { max-width: 820px; margin-inline: auto; text-align: center; }
	.pricing-heading > p:first-child { justify-content: center; }
	.pricing-intro { max-width: 660px; margin: 22px auto 0; color: #716b64; font-size: 13px; line-height: 1.75; }
	.pricing-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; gap: 18px; }
	.package-card { position: relative; min-width: 0; padding: 28px 28px 30px; border: 1px solid #ddd8d0; background: #fff; }
	.package-card.featured { border-top: 5px solid var(--yellow); background: var(--ink); color: #fff; box-shadow: 0 20px 42px rgb(38 23 17 / 14%); transform: translateY(-9px); }
	.package-top { display: flex; min-height: 29px; align-items: flex-start; justify-content: space-between; gap: 14px; }
	.package-top > span { color: var(--red); font-family: Georgia, serif; font-size: 17px; }
	.package-top small { padding: 6px 8px; background: var(--yellow); color: var(--ink); font-size: 7px; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
	.package-card h3 { margin: 25px 0 20px; color: var(--ink); font-family: Georgia, serif; font-size: 24px; font-weight: 500; }
	.package-card.featured h3 { color: #fff; }
	.package-price { display: flex; padding: 19px 0; flex-direction: column; gap: 6px; border-top: 1px solid #e4e0d9; border-bottom: 1px solid #e4e0d9; }
	.package-card.featured .package-price { border-color: #3f3f3f; }
	.package-price strong { color: var(--red); font-family: Georgia, serif; font-size: 31px; font-weight: 500; }
	.package-card.featured .package-price strong { color: var(--yellow); }
	.package-price > span { color: #938c84; font-size: 8px; text-transform: uppercase; }
	.package-card ul { display: grid; margin: 23px 0 27px; padding: 0; gap: 12px; list-style: none; }
	.package-card li { display: flex; align-items: flex-start; gap: 9px; color: #5f5953; font-size: 10.5px; line-height: 1.5; }
	.package-card.featured li { color: #cbc8c4; }
	.package-card li span { color: var(--red); }
	.package-card > a { display: flex; min-height: 44px; align-items: center; justify-content: space-between; padding: 0 15px; border: 1px solid var(--red); color: var(--red); font-size: 9px; font-weight: 800; letter-spacing: .06em; text-decoration: none; text-transform: uppercase; }
	.package-card.featured > a { background: var(--red); color: #fff; }
	.package-card > a span { font-size: 17px; }
	.package-card.featured > a span { color: var(--yellow); }
	.pricing-note { margin: 25px 0 0; color: #8c857e; font-size: 9px; line-height: 1.6; text-align: center; }

	.detail-section { padding: 98px 0; background: #fff; }
	.detail-grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: start; gap: clamp(60px, 9vw, 130px); }
	.detail-intro { margin: 24px 0 0; color: #6c665f; font-size: 14px; line-height: 1.8; }
	.detail-grid ul { display: grid; margin: 0; padding: 0; grid-template-columns: repeat(2, 1fr); border-top: 1px solid #d9d5ce; list-style: none; }
	.detail-grid li { display: flex; min-height: 75px; align-items: center; gap: 12px; padding: 10px 16px; border-bottom: 1px solid #d9d5ce; color: #48433e; font-size: 12px; line-height: 1.5; }
	.detail-grid li:nth-child(odd) { border-right: 1px solid #d9d5ce; }
	.detail-grid li span { display: grid; width: 20px; height: 20px; flex: 0 0 auto; place-items: center; border-radius: 50%; background: #f6e9c1; color: var(--red); font-size: 10px; }

	.process { padding: 100px 0; background: var(--ink); color: #fff; }
	.process-heading { max-width: 680px; margin-bottom: 48px; }
	.process-heading > p { color: var(--yellow); }
	.process-heading h2 { color: #fff; }
	.process-list { border-top: 1px solid #3d3d3d; }
	.process-list article { display: grid; grid-template-columns: 75px 1fr; gap: 25px; padding: 28px 0; border-bottom: 1px solid #3d3d3d; }
	.process-list strong { color: var(--yellow); font-family: Georgia, serif; font-size: 18px; }
	.process-list h3 { margin: 0 0 8px; font-family: Georgia, serif; font-size: 22px; font-weight: 500; }
	.process-list p { margin: 0; color: #aaa7a3; font-size: 12.5px; line-height: 1.7; }

	.private-cta { padding: 66px 0; background: var(--yellow); }
	.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 45px; }
	.cta-inner h2 { max-width: 760px; font-size: clamp(29px, 3.2vw, 42px); }
	.cta-inner a { white-space: nowrap; }

	@media (max-width: 850px) {
		.hero-grid, .detail-grid { grid-template-columns: 1fr; }
		.hero-copy { padding-top: 0; }
		.hero-image { width: min(600px, 100%); }
		.feature-grid { grid-template-columns: repeat(2, 1fr); }
		.feature-grid article:nth-child(3) { border-top: 1px solid #ddd9d2; border-left: 0; }
		.feature-grid article:nth-child(4) { border-top: 1px solid #ddd9d2; }
		.pricing-grid { grid-template-columns: 1fr; max-width: 580px; margin-inline: auto; }
		.package-card.featured { transform: none; }
	}

	@media (max-width: 620px) {
		.page-container { width: calc(100% - 36px); }
		.private-hero { padding: 56px 0 65px; }
		.hero-grid { gap: 45px; }
		.hero-actions { align-items: flex-start; flex-direction: column; }
		.features, .pricing, .detail-section, .process { padding: 70px 0; }
		.feature-grid { grid-template-columns: 1fr; }
		.feature-grid article + article { border-top: 1px solid #ddd9d2; border-left: 0; }
		.feature-grid h3 { min-height: 0; }
		.detail-grid ul { grid-template-columns: 1fr; }
		.detail-grid li:nth-child(odd) { border-right: 0; }
		.process-list article { grid-template-columns: 42px 1fr; gap: 13px; }
		.cta-inner { align-items: flex-start; flex-direction: column; }
	}
</style>
