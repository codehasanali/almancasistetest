---
const programs = [
	{
		title: 'Goethe / TELC Hazırlık',
		logo: '/goethe-logo.png',
		logoAlt: 'Goethe-Institut',
		description:
			'Uzman eğitmenlerle hedeflediğiniz Almanca dil sertifikası için online derslere katılın ve sınav formatına uygun pratiklerle hazırlanın.',
		package: '10 ders · 15.000 TL',
	},
	{
		title: 'ÖSD Hazırlık',
		description:
			'A1-C1 seviyelerinde okuma, dinleme, yazma ve konuşma bölümlerine sınav formatına uygun uygulama ve denemelerle hazırlanın.',
		package: '10 ders · 15.000 TL',
	},
	{
		title: 'TestDaF Hazırlık',
		logo: '/testdaf-logo.png',
		logoAlt: 'TestDaF',
		description:
			'B2-C1 dil bilgisi, grafik yorumlama, akademik metin yazma ve sözlü iletişim çalışmalarıyla TestDaF sınavına eksiksiz hazırlanın.',
		package: '10 ders · 15.000 TL',
	},
	{
		title: 'Abitur & Matura Hazırlık',
		description:
			'Alman Lisesi, İstanbul Erkek Lisesi ve Avusturya Lisesi öğrencilerine yönelik edebiyat, metin analizi ve metin üretme dersleri.',
		package: '10 ders · 15.000 TL',
	},
	{
		title: 'DSD Hazırlık',
		logo: '/dsd-hazirlik.jpg',
		logoAlt: 'Deutsches Sprachdiplom',
		description:
			'Almanya’da üniversite hedefleyen öğrenciler için yazma, okuma, dinleme ve konuşma becerilerini sınav formatında geliştiren dersler.',
		package: '10 ders · 15.000 TL',
	},
];
---

<section class="programs" id="programlar" aria-labelledby="programs-title">
	<div class="section-container">
		<div class="section-heading">
			<p><span></span> Online eğitim programları</p>
			<h2 id="programs-title">Online Almanca Kurs Alanlarımız <span>–</span> Sertifika ve Sınav Hazırlık Programları</h2>
			<div class="heading-line" aria-hidden="true"></div>
			<p class="intro">
				Almanca konuşulan ülkelerde eğitim veya çalışma hedefi olanlara yönelik sertifika ve
				sınav hazırlık programları sunuyoruz.
			</p>
		</div>

		<div class="program-list">
			{programs.map((program) => (
				<article class="program-item">
					<div class="program-symbol">
						{program.logo ? (
							<img src={program.logo} alt={program.logoAlt} loading="lazy" />
						) : (
							<span class="document-icon" aria-hidden="true">
								<svg viewBox="0 0 64 64">
									<path d="M16 5h24l10 10v42H16V5Z"></path>
									<path d="M40 5v11h10M23 25h20M23 32h15"></path>
									<circle cx="35" cy="44" r="7"></circle>
									<path d="m31 50-1 9 5-4 5 4-1-9"></path>
								</svg>
							</span>
						)}
					</div>
					<h3>{program.title}</h3>
					<p>{program.description}</p>
					<strong>{program.package}</strong>
				</article>
			))}
		</div>
	</div>
</section>

<style>
	.programs {
		--red: #dc0b20;
		--yellow: #f2b900;
		--ink: #1b1b1b;
		padding: 92px 0 100px;
		background: #f7f6f3;
		font-family: Inter, Arial, Helvetica, sans-serif;
		overflow: hidden;
	}

	.section-container { width: min(1370px, calc(100% - 64px)); max-width: 100%; margin-inline: auto; }
	.section-heading { max-width: 1050px; margin: 0 auto 58px; text-align: center; }
	.section-heading > p:first-child { display: flex; margin: 0 0 15px; align-items: center; justify-content: center; gap: 10px; color: var(--red); font-size: 10px; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
	.section-heading > p:first-child span { width: 28px; height: 3px; background: var(--yellow); }
	.section-heading h2 { margin: 0; color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(34px, 3.5vw, 49px); font-weight: 500; letter-spacing: -.035em; line-height: 1.12; }
	.section-heading h2 span { color: var(--red); }
	.heading-line { width: 42px; height: 3px; margin: 23px auto; background: var(--red); }
	.intro { max-width: 720px; margin: 0 auto; color: #6c665f; font-size: 14px; line-height: 1.75; }

	.program-list { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; border-top: 1px solid #ddd9d2; border-bottom: 1px solid #ddd9d2; }
	.program-item { min-width: 0; padding: 42px 30px 43px; background: transparent; text-align: center; }
	.program-item + .program-item { border-left: 1px solid #ddd9d2; }
	.program-symbol { display: grid; width: min(180px, 100%); height: 74px; margin: 0 auto 25px; place-items: center; }
	.program-symbol > img { display: block; width: 100%; height: 70px; object-fit: contain; }
	.program-symbol > img[src*='goethe'] { width: 70px; }
	.document-icon { display: grid; width: 70px; height: 70px; place-items: center; border: 1px solid #dedad3; background: #fff; color: var(--red); }
	.document-icon svg { width: 38px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
	.program-item h3 { min-height: 50px; margin: 0 0 14px; color: var(--ink); font-family: Georgia, 'Times New Roman', serif; font-size: 20px; font-weight: 500; line-height: 1.25; }
	.program-item > p { margin: 0; color: #746e67; font-size: 12.5px; line-height: 1.75; }
	.program-item > strong { display: block; margin-top: 18px; color: var(--red); font-family: Georgia, serif; font-size: 17px; font-weight: 500; }

	@media (max-width: 980px) {
		.program-list { grid-template-columns: repeat(2, 1fr); }
		.program-item:nth-child(odd) { border-left: 0; }
		.program-item:nth-child(n + 3) { border-top: 1px solid #ddd9d2; }
	}

	@media (max-width: 620px) {
		.programs { padding: 66px 0 72px; }
		.section-container { width: calc(100% - 36px); }
		.section-heading { margin-bottom: 40px; }
		.section-heading h2 { font-size: 38px; }
		.intro { font-size: 13px; }
		.program-list { grid-template-columns: 1fr; }
		.program-item { padding: 34px 20px 36px; }
		.program-item + .program-item { border-top: 1px solid #ddd9d2; border-left: 0; }
		.program-item h3 { min-height: 0; }
		.program-item > p { max-width: 430px; margin-inline: auto; }
	}
</style>
