---
interface Props { area: { code:string; title:string; eyebrow:string; lead:string; paragraphs:string[]; audience:string[]; topics:string[]; method:string; sources:string[][] } }
const { area } = Astro.props;
---
<main class="area-page"><section class="area-hero"><div class="page-container"><nav><a href="/">Ana Sayfa</a><span>→</span><a href="/ders-alanlari">Ders Alanları</a><span>→</span><strong>{area.code}</strong></nav><div class="hero-grid"><div class="code">{area.code}</div><div><p>{area.eyebrow}</p><h1>{area.title}</h1><p class="lead">{area.lead}</p></div></div></div></section><section class="area-content"><div class="page-container content-grid"><article><section class="intro">{area.paragraphs.map(p=><p>{p}</p>)}</section><section><div class="title"><span>01</span><h2>Kimler İçin Uygun?</h2></div><ul>{area.audience.map(item=><li><span>✓</span>{item}</li>)}</ul></section><section><div class="title"><span>02</span><h2>Programda Neler Var?</h2></div><ul class="topics">{area.topics.map(item=><li><span>→</span>{item}</li>)}</ul></section><section><div class="title"><span>03</span><h2>Program Yaklaşımı</h2></div><p>{area.method}</p></section></article><aside><div><p>Program bilgisi</p><h2>{area.title}</h2><ul><li><small>Format</small><strong>Canlı Online</strong></li><li><small>Planlama</small><strong>Hedefe Özel</strong></li><li><small>Seviye</small><strong>İhtiyaca Göre</strong></li></ul><a href="/iletisim">Bilgi Alın <span>→</span></a></div><section class="sources"><p>Bilgi kaynakları</p>{area.sources.map(source=><a href={source[1]} target="_blank" rel="noreferrer">{source[0]} <span>↗</span></a>)}</section></aside></div></section><section class="area-cta"><div class="page-container"><div><p>Size uygun program</p><h2>Hedefinizi birlikte değerlendirelim.</h2></div><a href="/iletisim">Eğitim Danışmanına Ulaşın <span>→</span></a></div></section></main>
<style>
	.area-page{--red:#dc0b20;--yellow:#f2b900;--ink:#1b1b1b;font-family:Inter,Arial,sans-serif;overflow:hidden}.page-container{width:min(1100px,calc(100% - 64px));max-width:100%;margin-inline:auto}.area-hero{padding:28px 0 72px;background:var(--ink);color:#fff}.area-hero nav{display:flex;margin-bottom:46px;align-items:center;gap:9px;color:#666;font-size:8px;text-transform:uppercase}.area-hero nav a{color:#888;text-decoration:none}.area-hero nav strong{color:var(--yellow)}.hero-grid{display:grid;grid-template-columns:170px 1fr;align-items:center;gap:50px}.code{display:grid;width:155px;height:155px;place-items:center;padding:10px;background:var(--red);color:var(--yellow);font-family:Georgia,serif;font-size:clamp(26px,3vw,42px);line-height:1;text-align:center;overflow-wrap:anywhere}.hero-grid>div:last-child>p:first-child{margin:0 0 12px;color:var(--yellow);font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}h1{margin:0;font-family:Georgia,serif;font-size:clamp(39px,4.6vw,58px);font-weight:500;letter-spacing:-.04em;line-height:1.03}.lead{max-width:760px;margin:20px 0 0;color:#b1aeaa;font-size:14px;line-height:1.75}.area-content{padding:90px 0 100px}.content-grid{display:grid;grid-template-columns:minmax(0,1fr)310px;align-items:start;gap:75px}.intro{padding-bottom:39px}.intro p,article section>p{margin:0;color:#625c56;font-size:13.5px;line-height:1.9}.intro p+p{margin-top:17px}article>section{padding:40px 0;border-bottom:1px solid #ddd9d2}.title{display:grid;margin-bottom:20px;grid-template-columns:38px 1fr;gap:15px}.title>span{padding-top:6px;border-top:3px solid var(--yellow);color:var(--red);font-family:Georgia,serif;font-size:14px;text-align:center}.title h2{margin:0;color:var(--ink);font-family:Georgia,serif;font-size:29px;font-weight:500}.content-grid article ul{display:grid;margin:0;padding:0;grid-template-columns:repeat(2,1fr);gap:10px 20px;list-style:none}.content-grid article li{display:flex;gap:10px;color:#625c56;font-size:12.5px;line-height:1.6}.content-grid article li span{color:var(--red);font-weight:800}.topics li{padding:11px 0;border-bottom:1px solid #eeeae4}aside{position:sticky;top:20px}aside>div{padding:26px 25px 27px;border-top:5px solid var(--yellow);background:#f5f3ef}aside>div>p,.sources>p{margin:0 0 9px;color:var(--red);font-size:8px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}aside h2{margin:0 0 20px;color:var(--ink);font-family:Georgia,serif;font-size:23px;font-weight:500}aside ul{margin:0 0 22px;padding:0;border-top:1px solid #dad5cd;list-style:none}aside li{display:flex;padding:12px 0;align-items:center;justify-content:space-between;border-bottom:1px solid #dad5cd}aside li small{color:#918b83;font-size:8px;text-transform:uppercase}aside li strong{color:var(--ink);font-size:10px}aside>div>a{display:flex;min-height:45px;align-items:center;justify-content:space-between;padding:0 15px;background:var(--red);color:#fff;font-size:9px;font-weight:800;text-decoration:none;text-transform:uppercase}aside>div>a span{color:var(--yellow);font-size:17px}.sources{display:grid;margin-top:20px;padding:20px;border:1px solid #ddd9d2;gap:8px}.sources>a{color:#6d675f;font-size:9px;line-height:1.4;text-decoration:none}.sources>a span{color:var(--red)}.area-cta{padding:62px 0;background:var(--yellow)}.area-cta>div{display:flex;align-items:center;justify-content:space-between;gap:40px}.area-cta p{margin:0 0 8px;color:var(--red);font-size:9px;font-weight:800;text-transform:uppercase}.area-cta h2{margin:0;color:var(--ink);font-family:Georgia,serif;font-size:35px;font-weight:500}.area-cta a{display:inline-flex;min-height:45px;align-items:center;gap:14px;padding:0 17px;background:var(--red);color:#fff;font-size:9px;font-weight:800;text-decoration:none;text-transform:uppercase;white-space:nowrap}.area-cta a span{color:var(--yellow);font-size:17px}
	@media(max-width:850px){.content-grid{grid-template-columns:1fr}aside{position:static;width:min(430px,100%)}}@media(max-width:620px){.page-container{width:calc(100% - 36px)}.area-hero{padding-bottom:57px}.hero-grid{grid-template-columns:1fr;gap:28px}.code{width:105px;height:105px}.area-content{padding:65px 0 75px}.content-grid article ul{grid-template-columns:1fr}.area-cta>div{align-items:flex-start;flex-direction:column}}
</style>
